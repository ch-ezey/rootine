# Copy to .env (gitignored) and fill in. Read by Spring Boot (spring.config.import)
# and by docker-compose. In production, set these as platform environment variables.

# Spring profile: dev | prod
SPRING_PROFILES_ACTIVE=dev

# Database
DB_URL=jdbc:postgresql://localhost:5432/rootine
DB_USERNAME=postgres
DB_PASSWORD=change-me

# JWT signing key: base64, at least 32 bytes. Generate with: openssl rand -base64 48
JWT_SECRET=
# Token lifetime in ms (default 24h)
JWT_EXPIRATION_MS=86400000

# Comma-separated list of allowed frontend origins
CORS_ALLOWED_ORIGINS=http://localhost:5173

# OpenAI
OPENAI_API_KEY=
